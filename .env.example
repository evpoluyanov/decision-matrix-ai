# Database

DATABASE_URL=sqlite:///./decision_matrix.db

# Application

HOST=127.0.0.1
PORT=8000
APP_BASE_URL=http://127.0.0.1:8000

# Signed sessions: generate a strong random value; never commit the real secret.
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_HTTPS_ONLY=false

# AI: keep the existing account endpoint/key. Preview deployments cannot spend.
LLM_PROVIDER=mws
LLM_MODEL=gpt-oss-120b
LLM_BASE_URL=
LLM_API_KEY=
AI_ENABLED=true
AI_REQUESTS_PER_MINUTE=3
AI_REQUESTS_PER_24_HOURS=30
AI_DAILY_BUDGET_RUB=100
# Day boundary: 00:00 Europe/Moscow. Prices include VAT; checked 2026-08-28.
# Verify these prices against YOUR MWS deployment before setting true.
AI_PRICING_CONFIRMED=false
AI_INPUT_RUB_PER_MILLION=13.42
AI_OUTPUT_RUB_PER_MILLION=54.90

# Admin access by immutable account ID, with verified email. Empty denies all.
ADMIN_USER_IDS=

# Optional: set AFTER connecting the domain and reviewing analytics notice.
# PUBLIC_SITE_URL=https://dmatrix.tech
PUBLIC_SITE_URL=
YANDEX_METRIKA_ID=

# Shared database throttles: login/password limits per 15 min, others per hour.
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_ACCOUNT_LIMIT=10
AUTH_REGISTER_IP_LIMIT=5
AUTH_RESEND_IP_LIMIT=10
AUTH_RESEND_USER_LIMIT=3
AUTH_PASSWORD_LIMIT=10

# Transactional email (Brevo)

BREVO_API_KEY=replace-with-your-brevo-api-key
BREVO_SENDER_EMAIL=no-reply@notify.dmatrix.tech
BREVO_SENDER_NAME=Decision Matrix AI
